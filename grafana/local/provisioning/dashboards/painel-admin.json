    {
      "id": 5,
      "type": "table",
      "title": "5. Log de Ações e Mudanças de Status de Alunos (Onboarding & Perfil)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-escola-uid"
          },
          "dataset": "boost",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    NOW() AS time,\n    CASE \n        WHEN ativo = 0 THEN 'WARNING'\n        WHEN senha IS NULL THEN 'INFO'\n        ELSE 'SUCCESS'\n    END AS level,\n    CONCAT(\n        'Aluno: ', nome, \n        ' (', email, ')',\n        ' | Nível: ', COALESCE(nivel, 'Não definido'),\n        ' | Status Conta: ', CASE WHEN ativo = 1 THEN 'Ativo' ELSE 'Inativo' END,\n        ' | Senha: ', CASE WHEN senha IS NULL THEN 'Pendente (Primeiro Acesso)' ELSE 'Configurada' END\n    ) AS message\nFROM aluno\nORDER BY id_aluno DESC\nLIMIT 50;",
