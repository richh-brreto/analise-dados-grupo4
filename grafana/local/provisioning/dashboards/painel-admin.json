    {
      "id": 3,
      "type": "table",
      "title": "3. Depuração e Diagnósticos de Integridade (System Health Audit)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-escola-uid"
          },
          "dataset": "boost",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    'Contrato Expirado Ativo' AS Tipo_Anomalia,\n    CONCAT('Contrato ID ', id_contrato) AS Entidade_Afetada,\n    CONCAT('Venceu em ', data_fim, ' mas ainda está registrado') AS Detalhes_Diagnostico\nFROM contrato\nWHERE data_fim < CURDATE()\n\nUNION ALL\n\nSELECT \n    'Aluno Sem Agenda' AS Tipo_Anomalia,\n    CONCAT('Aluno ID ', a.id_aluno, ' (', a.nome, ')') AS Entidade_Afetada,\n    'Aluno ativo sem nenhum horário registrado em disponibilidade_aluno' AS Detalhes_Diagnostico\nFROM aluno a\nLEFT JOIN disponibilidade_aluno da ON a.id_aluno = da.aluno_id_aluno\nWHERE a.ativo = 1 AND da.aluno_id_aluno IS NULL\n\nUNION ALL\n\nSELECT \n    'Turma Orfa' AS Tipo_Anomalia,\n    CONCAT('Turma ID ', id_turma, ' (', nome_turma, ')') AS Entidade_Afetada,\n    'Turma cadastrada sem professor_id_professor atribuido' AS Detalhes_Diagnostico\nFROM turma\nWHERE professor_id_professor IS NULL\n\nUNION ALL\n\nSELECT \n    'Sobrecarga de Agenda' AS Tipo_Anomalia,\n    CONCAT('Professor ID ', dp.professor_id_professor, ' (', p.nome, ')') AS Entidade_Afetada,\n    CONCAT('Professor possui ', COUNT(dp.horario_id_horario), ' horarios vinculados simultaneamente') AS Detalhes_Diagnostico\nFROM disponibilidade_professor dp\nJOIN professor p ON dp.professor_id_professor = p.id_professor\nGROUP BY dp.professor_id_professor, p.nome\nHAVING COUNT(dp.horario_id_horario) > 15;",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
