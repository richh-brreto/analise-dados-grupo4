            "uid": "mysql-escola-uid"
          },
          "dataset": "boost",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    p.id_professor,\n    p.nome AS Professor,\n    p.email,\n    GROUP_CONCAT(perm.nome SEPARATOR ' | ') AS Telas_Liberadas\nFROM professor p\nLEFT JOIN professor_permissao pp ON p.id_professor = pp.professor_id_professor\nLEFT JOIN permissao perm ON pp.permissao_id_permissao = perm.id_permissao\nGROUP BY p.id_professor, p.nome, p.email;",
