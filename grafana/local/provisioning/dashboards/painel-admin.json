    {
      "id": 4,
      "type": "table",
      "title": "4. Auditoria de Segurança e Contas (Security & Access Health Audit)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-escola-uid"
          },
          "dataset": "boost",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    'Professor Sem Senha (Risco)' AS Tipo_Alerta,\n    CONCAT('Professor ID ', id_professor, ' (', nome, ')') AS Entidade_Afetada,\n    CONCAT('E-mail: ', email, ' - Senha nunca foi configurada (Pendente de Primeiro Acesso)') AS Detalhes_Diagnostico\nFROM professor\nWHERE senha IS NULL\n\nUNION ALL\n\nSELECT \n    'Código de Acesso Expirado/Órfão' AS Tipo_Alerta,\n    CONCAT('Aluno ID ', id_aluno, ' (', nome, ')') AS Entidade_Afetada,\n    CONCAT('Possui código de acesso pendente (', codigo_acesso, ') mas a conta já foi ativada ou modificada') AS Detalhes_Diagnostico\nFROM aluno\nWHERE senha IS NOT NULL AND codigo_acesso IS NOT NULL\n\nUNION ALL\n\nSELECT \n    'Professor Sem Telas Liberadas' AS Tipo_Alerta,\n    CONCAT('Professor ID ', p.id_professor, ' (', p.nome, ')') AS Entidade_Afetada,\n    'Professor ativo no sistema mas não possui nenhuma permissão de tela vinculada em professor_permissao' AS Detalhes_Diagnostico\nFROM professor p\nLEFT JOIN professor_permissao pp ON p.id_professor = pp.professor_id_professor\nWHERE p.ativo = 1 AND pp.permissao_id_permissao IS NULL\n\nUNION ALL\n\nSELECT \n    'Aluno Inativo com Contrato Ativo' AS Tipo_Alerta,\n    CONCAT('Aluno ID ', a.id_aluno, ' (', a.nome, ')') AS Entidade_Afetada,\n    'Aluno marcado como inativo (ativo = 0), mas possui vínculos contratuais pendentes' AS Detalhes_Diagnostico\nFROM aluno a\nJOIN contrato c ON a.id_aluno = c.aluno_id_aluno\nWHERE a.ativo = 0;",
          "sql": {
